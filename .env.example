# --- Identity ---
# Public address only. NEVER put a seed phrase/private key here.
AGENT_WALLET=

# --- XDEX / X1.Ninja ---
# Current AGI/XNT XDEX pool documented by AgentID.
POOL_ADDRESS=4sn8oCQWPikDxBkyRdd1S6bJ24oYjGF16aR7ZqCSXy4v
X1_NINJA_API_KEY=
X1_RPC_URL=https://rpc.mainnet.x1.xyz
# Default AGI/XNT vaults documented by AgentID.
BASE_TOKEN_VAULT=ELG1JmpJETYxZCwFBesCrpJDukfrMmND3gKtVnsKtMgi
QUOTE_TOKEN_VAULT=FSxoLLMasBzDnqPDU7VzKXDmfp34cKJxXQsoXQEvwECf
TIMEFRAME=5m
CANDLE_LIMIT=60
POLL_SECONDS=60

# --- CMIS Scout gateway ---
# Keep the Python gateway loopback-only even for the public HTTPS deployment
# profile. A reverse proxy terminates TLS and forwards to 127.0.0.1:8765.
# CMIS_API_KEY must be set before that reverse proxy is exposed publicly.
CMIS_HOST=127.0.0.1
CMIS_PORT=8765
CMIS_API_KEY=

# --- CMIS Solana read-only provider (Phase 10) ---
# Disabled by default. Enabling this never enables signing, broadcasting, custody,
# transaction construction, or execution.
CMIS_SOLANA_PROVIDER_ENABLED=0
# Canonical RPC. Leave blank to use Solana public mainnet RPC when enabled.
SOLANA_RPC_URL=
# Jupiter Price V3 currently requires an API key. If blank, Jupiter-dependent
# market/history services fail closed while canonical RPC services can still run.
JUPITER_API_KEY=
# Helius is optional independent indexed evidence. If blank, canonical RPC supply
# remains available without the Helius cross-check.
HELIUS_API_KEY=
# Explicit deployment policies. Leave blank to keep the dependent evidence gate off.
CMIS_SOLANA_PRICE_MAX_RELATIVE_DIFFERENCE=
CMIS_SOLANA_SUPPLY_MAX_INDEX_SLOT_LAG=
CMIS_SOLANA_HISTORY_MAX_DISTANCE_SECONDS=
# Optional persistent provenance-safe history database.
# Default when blank: ~/.liquidity_scout/solana_observations.db
CMIS_SOLANA_OBSERVATION_DB=

# --- Paper portfolio ---
QUOTE_SYMBOL=XNT
BASE_SYMBOL=AGI


# --- Strategy ---
VOLUME_SPIKE_RATIO=1.50

# --- Risk ---
MIN_LIQUIDITY_USD=50000


# --- HXMP ---
# v0.1 never auto-writes to chain. Important events are queued for review.
HXMP_QUEUE_ENABLED=true
